# Twelve Data API key for supported global exchange quotes and daily candles.
# Real-time/delayed availability varies by exchange and provider subscription.
TWELVE_DATA_API_KEY=
# Per-refresh request cap; the default fits within the provider's basic request budget.
TWELVE_DATA_SYMBOL_LIMIT=8
# Per-refresh cap for the no-key Yahoo Finance fallback.
YAHOO_SYMBOL_LIMIT=8

# Optional AI market explainer (keep this key server-side; never add it to public/).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional runtime settings
PORT=3000
# Optional path/command for the Python NEPSE adapter in a persistent Node deployment.
PYTHON_BIN=
# Optional Vercel deployment-protection bypass token for the Node-to-Python function call.
VERCEL_AUTOMATION_BYPASS_SECRET=
